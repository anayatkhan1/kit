{
  "name": "agentcn",
  "version": "0.2.1",
  "description": "A CLI for adding AI agents to your project",
  "license": "MIT",
  "author": "Anayat Khan",
  "homepage": "https://agentcn.dev/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anayatkhan1/kit.git",
    "directory": "packages/agentcn/cli"
  },
  "bugs": {
    "url": "https://github.com/anayatkhan1/kit/issues"
  },
  "keywords": [
    "agentcn",
    "ai",
    "agents",
    "cli",
    "nextjs",
    "vercel-ai-sdk",
    "typescript",
    "web-agent",
    "llm"
  ],
  "bin": {
    "agentcn": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "pnpm run build && node --test dist/tests/**/*.test.js",
    "pack:smoke": "pnpm run build && pnpm pack --pack-destination ./.artifacts",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run test"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "commander": "^12.1.0",
    "path-exists": "^5.0.0",
    "picocolors": "^1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
