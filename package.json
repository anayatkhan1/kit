{
  "name": "@kit/source",
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "license": "MIT",
  "scripts": {
    "agentcn:registry:build": "pnpm exec tsx scripts/build-agent-registry.mts",
    "agentcn:build": "pnpm --filter agentcn build",
    "web": "npx nx run @kit/web:dev ",
    "web:build": "npx nx run @kit/web:build",
    "web:lint": "npx nx run @kit/web:lint",
    "web:lint:fix": "npx nx run @kit/web:lint:fix",
    "web:typecheck": "npx nx run @kit/web:typecheck",
    "web:format:write": "npx nx run @kit/web:format:write",
    "web:format:check": "npx nx run @kit/web:format:check",
    "web:clean": "npx nx run @kit/web:clean",
    "web:registry:capture": "npx nx run @kit/web:registry:capture",
    "web:registry:build": "npx nx run @kit/web:registry:build",
    "web:postinstall": "npx nx run @kit/web:postinstall",
    "deploy:build": "pnpm agentcn:registry:build && pnpm web:build",
    "agentcn:registry:verify-live": "bash scripts/verify-agentcn-registry-live.sh",
    "agentcn:runner-matrix-smoke": "bash scripts/agentcn-runner-matrix-smoke.sh",
    "release": "nx release",
    "release:skip-publish": "nx release --skip-publish",
    "release:version": "nx release version",
    "release:changelog": "nx release changelog",
    "release:publish": "nx release publish",
    "clean": "rm -rf node_modules",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:web-agent": "jest ai/agents/web",
    "test:extraction-agent": "jest ai/agents/extraction",
    "test:ecommerce-agent": "jest ai/agents/ecommerce"
  },
  "private": true,
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@nx/js": "22.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.37",
    "agentcn": "workspace:*",
    "dotenv": "^16.5.0",
    "jest": "^29.7.0",
    "nx": "22.6.0",
    "ts-jest": "^29.4.1",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2"
  },
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*",
    "packages/*/*"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.69",
    "@mendable/firecrawl-js": "^1.29.1",
    "ai": "^6.0.161",
    "anchorbrowser": "^0.16.3",
    "exa-js": "^1.8.27",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.59.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  }
}
